PORT=3000
NODE_ENV=development

# Create the database "auth_db" in MySQL before running migrations.
DATABASE_URL="mysql://root:your_password@localhost:3306/auth_db"

# Replace this with a unique random secret (at least 32 bytes).
JWT_SECRET="replace_with_a_random_secret_at_least_32_bytes_long"
JWT_EXPIRES_IN="15m"
